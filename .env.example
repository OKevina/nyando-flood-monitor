# Copernicus Data Space Ecosystem (CDSE) OAuth2 Credentials
# Register at: https://dataspace.copernicus.eu/
# NOTE: pipeline/02_copernicus_pipeline.py reads CLIENT_ID / CLIENT_SECRET
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# PostgreSQL + PostGIS (see backend/.env.example for details)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nyando_flood

# Required for admin endpoints (trigger pipeline, upload imagery)
ADMIN_API_KEY=your_admin_api_key_here
