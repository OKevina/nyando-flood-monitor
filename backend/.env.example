# PostgreSQL + PostGIS connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nyando_flood
# Leave unset/empty to disable API-key auth (local development only).
# Set a value to enforce X-API-Key checks on admin endpoints.
# ADMIN_API_KEY=your_admin_api_key_here
